// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Documents: any authenticated user can read/write
    match /documents/{docId} {
      allow read, write: if request.auth != null;
      
      match /cells/{cellId} {
        allow read, write: if request.auth != null;
      }
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
